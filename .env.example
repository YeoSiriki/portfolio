# Copier ce fichier en « .env » puis renseigner les valeurs. Ne jamais publier le fichier .env.

# Adresse publique du site. En production : le nom de domaine personnel (https://...).
NEXT_PUBLIC_SITE_URL="http://localhost:3001"

# Base PostgreSQL. En développement : la base « portfolio » du serveur PostgreSQL 18 de la machine (port 5432),
# avec l'utilisateur dédié « portfolio » (voir README). Variante : la base propre au projet lancée par
# « npm run db:local », à l'adresse postgresql://portfolio@localhost:5434/portfolio.
# En production : l'adresse de la base managée.
DATABASE_URL="postgresql://portfolio:MOT_DE_PASSE@localhost:5432/portfolio"

# Secret des sessions. Générer une valeur avec : npx auth secret
AUTH_SECRET=""

# Compte administrateur créé par « npm run db:seed ».
ADMIN_EMAIL="sirikikyeo@gmail.com"
# Facultatif : mot de passe initial. Laissé vide, il est généré et affiché une seule fois par le seed.
ADMIN_PASSWORD=""

# Connexion GitHub (facultative), limitée au compte indiqué dans ADMIN_GITHUB_LOGIN.
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
ADMIN_GITHUB_LOGIN=""

# E-mails : notification des nouveaux messages et réponses depuis l'admin.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM=""
# Destinataire des notifications. Vide : l'e-mail public du profil.
MAIL_TO=""

# Fichiers : stockage compatible S3. Laissé vide, les fichiers vont dans STORAGE_DIR (développement).
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
STORAGE_DIR="./storage"
